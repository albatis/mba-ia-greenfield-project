# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (Garage, S3-compatible) — keys must match docker/garage/bootstrap.sh
S3_ENDPOINT=http://storage:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GK1d8b0106b0f6bd86d6cdd15c
S3_SECRET_ACCESS_KEY=149499a81e704dc35e7ca75f1e5d75874578a91b0a3ba3eee1a83cf6859703a8
S3_FORCE_PATH_STYLE=true
S3_VIDEOS_BUCKET=videos
S3_THUMBNAILS_BUCKET=thumbnails
THUMBNAILS_PUBLIC_BASE_URL=http://thumbnails.web.garage.localhost:3902
STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:3001

# Queue (BullMQ on Redis)
REDIS_HOST=redis
REDIS_PORT=6379
VIDEO_WORKER_CONCURRENCY=2

# Upload limits — part size >= 5 MiB and max size / part size <= 10,000 parts
UPLOAD_MAX_SIZE_BYTES=10737418240
UPLOAD_PART_SIZE_BYTES=67108864
UPLOAD_PART_URL_TTL_SECONDS=3600
VIDEO_URL_TTL_SECONDS=14400
UPLOAD_STALE_AFTER_HOURS=24
UPLOAD_CLEANUP_INTERVAL_MS=3600000
