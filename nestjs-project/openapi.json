    "/videos/{videoId}/stream-url": {
      "get": {
        "description": "Signs a short-lived storage URL for inline playback. Storage serves Range requests directly; request a new URL when storage answers 403.",
        "operationId": "VideosController_getStreamUrl",
        "parameters": [
          {
            "name": "videoId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
