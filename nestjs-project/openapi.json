  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {}
      },
      "InitiateUploadResponseDto": {
        "type": "object",
        "properties": {
          "processingStatus": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ],
            "example": "uploading"
          },
          "publicationStatus": {
            "type": "string",
            "enum": [
              "draft"
            ],
            "example": "draft"
          }
        },
        "required": [
          "processingStatus",
          "publicationStatus"
        ]
      },
      "SignPartsDto": {
        "type": "object",
        "properties": {}
      },
      "SignedPartsResponseDto": {
        "type": "object",
        "properties": {}
      },
      "UploadPartsResponseDto": {
        "type": "object",
        "properties": {}
      },
      "CompleteUploadDto": {
        "type": "object",
        "properties": {}
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "processingStatus": {
            "type": "string",
            "enum": [
              "uploading",
              "processing",
              "ready",
              "failed"
            ]
          },
          "publicationStatus": {
            "type": "string",
            "enum": [
              "draft"
            ]
          },
          "failureReason": {
            "type": "string",
            "enum": [
              "FILE_TOO_LARGE",
              "UNSUPPORTED_CODEC",
              "PROBE_FAILED",
              "PROCESSING_ERROR",
              "UPLOAD_ABANDONED"
            ],
            "nullable": true
          }
        },
        "required": [
          "processingStatus",
          "publicationStatus",
          "failureReason"
        ]
      },
      "MediaUrlResponseDto": {
        "type": "object",
        "properties": {}
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}