        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Start a video upload",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{videoId}/upload/parts": {
      "post": {
        "description": "Signs presigned PUT URLs for the requested parts. Also used to re-sign missing parts when resuming an upload.",
